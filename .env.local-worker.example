# Copiez ce fichier en ".env.local-worker" (déjà ignoré par git, voir .gitignore) et remplissez les
# valeurs, puis lancez :  node --env-file=.env.local-worker scripts/local-scrape-worker.js

# URL de l'app déployée (sans slash final) — la preview Vercel de la branche test, par exemple.
APP_BASE_URL=https://aia-mg-test-xxxxxxxxx.vercel.app

# Code d'accès (identique à celui saisi sur /login.html)
APP_ACCESS_CODE=

# Optionnel — chemin vers chrome.exe si différent de l'emplacement standard Windows
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optionnel — cookies de consentement publicitaire pour PARCELSAPP (JSON), voir le commentaire
# "getParcelsappCookies" dans lib/scrapers/parcelsapp.js (scripts/extract-parcelsapp-cookies.js).
# Ne suffit pas toujours seul avec un profil neuf — voir CHROME_USER_DATA_DIR ci-dessous.
# PARCELSAPP_COOKIES_JSON=[...]

# Recommandé pour PARCELSAPP — chemin vers VOTRE VRAI profil Chrome (Chrome doit être complètement
# fermé pendant que le script tourne). Seule option constatée fiable en pratique.
# CHROME_USER_DATA_DIR=C:\Users\VOTRE_NOM\AppData\Local\Google\Chrome\User Data

# Optionnel — transporteurs à traiter (défaut : les deux)
# CARRIERS=parcelsapp,wanbexpress

# Optionnel — nombre d'onglets en parallèle (défaut 6 — un PC de bureau encaisse mieux la
# concurrence qu'une fonction serverless Vercel à CPU partagé ; ajustez selon vos performances)
# CONCURRENCY=6

# Optionnel — délai d'attente après chargement de page avant lecture, en ms (défaut 4000)
# PAGE_LOAD_WAIT_MS=4000
